# ==========================================
# BharatDoc Production Environment Variables
# ==========================================

# ── General ──
# The domain name for your deployment (e.g., bharatdoc.yourcompany.com)
# Caddy will automatically provision Let's Encrypt SSL for this domain.
DOMAIN_NAME=bharatdoc.yourcompany.com

# ── Security ──
# Generate a secure random string: `openssl rand -hex 32`
SECRET_KEY=replace_this_with_a_long_random_string_in_production
ALLOWED_ORIGINS=https://bharatdoc.yourcompany.com
ALLOWED_HOSTS=bharatdoc.yourcompany.com,localhost,127.0.0.1,backend

# ── Database ──
# Secure passwords for the Postgres database
POSTGRES_USER=bharatdoc_user
POSTGRES_PASSWORD=replace_with_strong_db_password
POSTGRES_DB=bharatdoc_prod

# ── Answer Engine (LLM) ──
# Set to 'true' to enable local LLM synthesis (requires Ollama running on the host)
USE_LLM=false
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1

# ── Upload Limits ──
# Max size in bytes (default is 50MB)
MAX_UPLOAD_SIZE=52428800

# ── Email / SMTP (Phase 18: Auth Hardening) ──
# Required for: email verification, password reset, security notifications
# Gmail App Password: https://myaccount.google.com/apppasswords
# Outlook: Use smtp-mail.outlook.com:587
# AWS SES: Use email-smtp.<region>.amazonaws.com:587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=BharatDoc
SMTP_USE_TLS=true

# ── Auth Hardening ──
# Set to "false" to skip email verification (dev/testing mode)
REQUIRE_EMAIL_VERIFICATION=true

# Frontend URL for email links (must match your deployed frontend)
FRONTEND_URL=https://bharatdoc.yourcompany.com
