# ==========================================
# BharatDoc Production Environment Variables
# ==========================================

# ── General ──
# The domain name for your deployment (e.g., bharatdoc.yourcompany.com)
# Caddy will automatically provision Let's Encrypt SSL for this domain.
DOMAIN_NAME=bharatdoc.yourcompany.com

# ── Security ──
# Generate a secure random string: `openssl rand -hex 32`
SECRET_KEY=replace_this_with_a_long_random_string_in_production
ALLOWED_ORIGINS=https://bharatdoc.yourcompany.com
ALLOWED_HOSTS=bharatdoc.yourcompany.com,localhost,127.0.0.1,backend

# ── Database ──
# Secure passwords for the Postgres database
POSTGRES_USER=bharatdoc_user
POSTGRES_PASSWORD=replace_with_strong_db_password
POSTGRES_DB=bharatdoc_prod

# ── Answer Engine (LLM) ──
# Set to 'true' to enable local LLM synthesis (requires Ollama running on the host)
USE_LLM=false
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1

# ── Upload Limits ──
# Max size in bytes (default is 50MB)
MAX_UPLOAD_SIZE=52428800
