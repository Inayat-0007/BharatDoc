FROM python:3.11-slim

WORKDIR /app

# Install system dependencies for OCR and processing
RUN apt-get update && apt-get install -y \
    tesseract-ocr \
    tesseract-ocr-hin \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Install python dependencies including gunicorn for production
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt gunicorn

# Create unprivileged user before model downloads so model caches are owned by
# the same user that runs the app. HuggingFace (~/.cache/huggingface) and
# PaddleOCR (~/.paddleocr) both use the home directory of the CURRENT user,
# so downloading as root and running as appuser would cause a cache miss and
# trigger a full re-download on every container start.
RUN useradd -m appuser
USER appuser

# Pre-download all models as appuser — stored in /home/appuser/.cache/huggingface
# and /home/appuser/.paddleocr — consistent with the user that serves requests.
RUN python -c "from sentence_transformers import SentenceTransformer, CrossEncoder; \
    SentenceTransformer('BAAI/bge-m3'); \
    CrossEncoder('cross-encoder/ms-marco-MiniLM-L-6-v2'); \
    from transformers import pipeline; pipeline('text2text-generation', model='google/flan-t5-base')"

# Pre-download PaddleOCR models (det, rec, cls for English)
RUN python -c "from paddleocr import PaddleOCR; PaddleOCR(use_angle_cls=True, lang='en', show_log=False)"

# Copy source code and fix ownership
USER root
COPY . .
RUN chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

# Run with Gunicorn and Uvicorn workers
# Use 4 workers, binding to 0.0.0.0:8000
CMD ["gunicorn", "main:app", "--workers", "4", "--worker-class", "uvicorn.workers.UvicornWorker", "--bind", "0.0.0.0:8000", "--timeout", "120"]
